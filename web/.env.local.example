NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
NEXT_PUBLIC_API_URL=http://localhost:8000
GROQ_API_KEY=
OPENAI_API_KEY=

# Set to "1" on a public demo deployment to show the amber "DEMO" badge on the home header.
NEXT_PUBLIC_DEMO_MODE=0

# Comma-separated list of cash handler names shown in the Cash tab's "Paid by" / "Counted by"
# pickers. "Other" is always appended. Demo example: "Manager,Owner"
NEXT_PUBLIC_CASH_HANDLERS=Prabhakaran,Lakshmi

# DEV ONLY — demo login against the local sandbox API (app/auth/dev-login/route.ts).
# Put these in .env.development.local (gitignored), NEVER in production envs.
# DEV_DEMO_JWT_SECRET must equal SUPABASE_JWT_SECRET passed to tests/sandbox/sandbox_server.py.
# DEV_DEMO_LOGIN=1
# DEV_DEMO_JWT_SECRET=<random local secret>
